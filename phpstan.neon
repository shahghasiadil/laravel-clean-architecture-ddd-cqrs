includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:

    paths:
        - src/
        - app/
        - database/
        - tests/

    # Level 10 is the highest level. Raised from 5 as part of the Laravel 13
    # upgrade; bump further once CI is green at this level with a baseline
    # covering any pre-existing findings (see docs/UPGRADE-PLAN-LARAVEL-13.md
    # Phase 12) rather than re-lowering it.
    level: 6

    tmpDir: bootstrap/cache/phpstan

#    ignoreErrors:
#        - '#PHPDoc tag @var#'
#
#    excludePaths:
#        - ./*/*/FileToBeExcluded.php
